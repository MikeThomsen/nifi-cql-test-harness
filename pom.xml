<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.nifi.testharness.cql</groupId>
    <artifactId>nifi-cql-test-harness</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cassandra.driver.version>4.19.3</cassandra.driver.version>
        <scylladb.driver.version>4.19.2.0</scylladb.driver.version>
        <picocli.version>4.7.7</picocli.version>
    </properties>

    <dependencies>
        <!-- Apache License 2.0: https://github.com/remkop/picocli/blob/main/LICENSE -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          The DataStax OSS driver was donated to the Apache Cassandra project; the actively
          maintained coordinate is org.apache.cassandra:java-driver-core (the legacy
          com.datastax.oss:java-driver-core coordinate is frozen at 4.17.0).
        -->
        <profile>
            <id>cassandra</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.cassandra</groupId>
                    <artifactId>java-driver-core</artifactId>
                    <version>${cassandra.driver.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>scylladb</id>
            <dependencies>
                <dependency>
                    <groupId>com.scylladb</groupId>
                    <artifactId>java-driver-core</artifactId>
                    <version>${scylladb.driver.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
