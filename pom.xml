<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.nifi.testharness.cql</groupId>
    <artifactId>nifi-cql-test-harness</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cassandra.driver.version>4.19.3</cassandra.driver.version>
        <scylladb.driver.version>4.19.2.0</scylladb.driver.version>
        <picocli.version>4.7.7</picocli.version>
        <nifi.security.cert.builder.version>2.11.0</nifi.security.cert.builder.version>
        <nifi.record.version>2.11.0</nifi.record.version>
        <datafaker.version>2.7.0</datafaker.version>
        <main.class>org.apache.nifi.testharness.cql.Main</main.class>
    </properties>

    <dependencies>
        <!-- Apache License 2.0: https://github.com/remkop/picocli/blob/main/LICENSE -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <!--
          Apache License 2.0. Annotation processor that generates GraalVM reflect-config.json for every
          @Command class (Main, StartCommand, ...) at compile time - without it, native-image only knows how
          to reflectively instantiate picocli's own internals (from the downloaded reachability metadata), not
          this project's command classes, and `start` fails at runtime with NoSuchMethodException even though
          the native-image build itself succeeds. provided scope: only needed at compile time.
        -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>${picocli.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Apache License 2.0. Self-signed and CA-signed X.509 certificate/keystore generation for
          the `start` subcommand's SSL setup (one-way and two-way TLS). Transitively brings in
          Bouncy Castle (bcpkix-jdk18on, bcprov-jdk18on) under the Bouncy Castle License
          (MIT-style) - see NOTICE.
        -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-security-cert-builder</artifactId>
            <version>${nifi.security.cert.builder.version}</version>
        </dependency>
        <!--
          Apache License 2.0. The Record/RecordSchema/RecordFieldType model that the ported record<->CQL
          conversion logic (see org.apache.nifi.testharness.cql.convert) operates on - the same model
          nifi-cql-bundle itself uses, so ported values are genuinely NiFi Records, not a look-alike.
        -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-record</artifactId>
            <version>${nifi.record.version}</version>
        </dependency>
        <!--
          Apache License 2.0. Provides AvroTypeUtil, used to convert the Avro Schema the ported
          CqlUdtSchemaMapper produces from CQL column metadata into a RecordSchema - the same
          CQL -> Avro -> RecordSchema pipeline CassandraCQLExecutionService#createSchema uses in
          nifi-cql-bundle. Transitively brings in Avro itself.
        -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-avro-record-utils</artifactId>
            <version>${nifi.record.version}</version>
        </dependency>
        <!--
          Apache License 2.0. Fake data generation for `generate-test-data`. The original
          com.github.javafaker:javafaker is unmaintained (last release 2020); DataFaker is its
          actively maintained successor - see NOTICE.
        -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <!--
                      Explicit annotationProcessorPaths, rather than relying on picocli-codegen just being on
                      the compile classpath: classpath-based implicit annotation processor discovery isn't
                      firing with this javac/maven-compiler-plugin combination, so picocli-codegen's
                      reflect-config.json for @Command classes never got generated without this.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The DataStax OSS driver was donated to the Apache Cassandra project; the actively
          maintained coordinate is org.apache.cassandra:java-driver-core (the legacy
          com.datastax.oss:java-driver-core coordinate is frozen at 4.17.0).
        -->
        <profile>
            <id>cassandra</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.cassandra</groupId>
                    <artifactId>java-driver-core</artifactId>
                    <version>${cassandra.driver.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>scylladb</id>
            <dependencies>
                <dependency>
                    <groupId>com.scylladb</groupId>
                    <artifactId>java-driver-core</artifactId>
                    <version>${scylladb.driver.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.6</version>
                        <!--
                          Works around a classloading gap in some Maven distributions: the plugin expects to
                          import org.apache.maven.shared.utils.logging.MessageUtils from Maven core's
                          "maven.api" realm, but not every Maven build exports that class there even though the
                          jar is physically present in Maven's own lib/. Depending on it directly puts the class
                          in the plugin's own classloader instead, avoiding the cross-realm import entirely.
                        -->
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.shared</groupId>
                                <artifactId>maven-shared-utils</artifactId>
                                <version>3.4.2</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <!--
                              The ScyllaDB/Cassandra driver's shaded Guava reaches
                              UnsignedBytes$LexicographicalComparatorHolder$PureJavaComparator (via
                              SniEndPoint's static sort comparator) during TrustManagerFactory's default-algorithm
                              static init, which native-image otherwise defers to run time by default - this
                              build arg is GraalVM's own suggested fix for the resulting UnsupportedFeatureException.
                            -->
                            <buildArgs>
                                <buildArg>--initialize-at-build-time=com.datastax.oss.driver.shaded.guava.common.primitives.UnsignedBytes$LexicographicalComparatorHolder$PureJavaComparator</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
